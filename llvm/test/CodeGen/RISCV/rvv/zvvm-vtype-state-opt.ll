  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %c2, ptr %p,
  i64 %ld, i64 %vl)
  %v1 = call <vscale x 2 x i32> @llvm.riscv.vadd.nxv2i32.nxv2i32.i64(
  <vscale x 2 x i32> poison, <vscale x 2 x i32> %a,
  <vscale x 2 x i32> %b, i64 %vl)
  %w = call i64 @llvm.riscv.vsetlambda.i64(i64 2)
  %c3 = call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
  <vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
  <vscale x 2 x i32> %b, i64 %vl)
  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %c3, ptr %p,
  i64 %ld, i64 %vl)
  %v2 = call <vscale x 2 x i32> @llvm.riscv.vadd.nxv2i32.nxv2i32.i64(
  <vscale x 2 x i32> poison, <vscale x 2 x i32> %a,
  <vscale x 2 x i32> %b, i64 %vl)
  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %v1, ptr %p,
  i64 %ld, i64 %vl)
