; IR-level modelling of the Zvvm matrix vtype state: the writers
; (vsetlambda / vsetvl_matrix) are `memory(inaccessiblemem: readwrite)`, the
; MACs and query_lambda `memory(inaccessiblemem: read)`, tile loads
; `memory(argmem: read, inaccessiblemem: read)` and tile stores
; `memory(argmem: write, inaccessiblemem: read)`. Ordinary RVV intrinsics
; (including llvm.riscv.vsetvli) stay `memory(none)`.

declare i64 @llvm.riscv.vsetvli.i64(i64, i64 immarg, i64 immarg)
declare i64 @llvm.riscv.vsetlambda.i64(i64)
declare i64 @llvm.riscv.query.lambda.i64()
declare i64 @llvm.riscv.vsetvl.matrix.i64(i64, i64 immarg, i64 immarg,
  i64 immarg, i64 immarg, i64 immarg, i64 immarg, i64 immarg, i64 immarg)
declare <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
  <vscale x 2 x i32>, <vscale x 2 x i32>, <vscale x 2 x i32>, i64)
declare <vscale x 2 x i32> @llvm.riscv.vadd.nxv2i32.nxv2i32.i64(
  <vscale x 2 x i32>, <vscale x 2 x i32>, <vscale x 2 x i32>, i64)
declare <vscale x 2 x i32> @llvm.riscv.vmtl.nxv2i32.p0.i64(
  <vscale x 2 x i32>, ptr, i64, i64)
declare void @llvm.riscv.vmts.nxv2i32.p0.i64(
  <vscale x 2 x i32>, ptr, i64, i64)

; Reproducer: `__riscv_vsetvl_e16m4(1024); (void)__riscv_vsetlambda(16);`.
; The unused vsetvli folds away; the lambda writes must not.
define void @unused_write() {
; CHECK-LABEL: define void @unused_write(
; CHECK-SAME: ) local_unnamed_addr #[[ATTR5:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 5)
; CHECK-NEXT:    [[M:%.*]] = tail call i64 @llvm.riscv.vsetvl.matrix.i64(i64 1024, i64 1, i64 2, i64 1, i64 1, i64 5, i64 0, i64 0, i64 0)
; CHECK-NEXT:    ret void
;
  %vl = call i64 @llvm.riscv.vsetvli.i64(i64 1024, i64 1, i64 2)
  %r = call i64 @llvm.riscv.vsetlambda.i64(i64 5)
  %m = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 1024, i64 1, i64 2,
  i64 1, i64 1, i64 5, i64 0, i64 0, i64 0)
  ret void
}

; Reproducer: `x = __riscv_vsetlambda(16); __riscv_vsetvl_e32m4(512);
; y = __riscv_vsetlambda(16);` must keep both writes.
define i64 @write_not_cse() {
; CHECK-LABEL: define i64 @write_not_cse(
; CHECK-SAME: ) local_unnamed_addr #[[ATTR5]] {
; CHECK-NEXT:    [[X:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 5)
; CHECK-NEXT:    [[Y:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 5)
; CHECK-NEXT:    [[S:%.*]] = add i64 [[Y]], [[X]]
; CHECK-NEXT:    ret i64 [[S]]
;
  %x = call i64 @llvm.riscv.vsetlambda.i64(i64 5)
  %vl = call i64 @llvm.riscv.vsetvli.i64(i64 512, i64 2, i64 2)
  %y = call i64 @llvm.riscv.vsetlambda.i64(i64 5)
  %s = add i64 %x, %y
  ret i64 %s
}

; query_lambda is CSE'd when no write intervenes, but not across a write.
define i64 @query_cse() {
; CHECK-LABEL: define i64 @query_cse(
; CHECK-SAME: ) local_unnamed_addr #[[ATTR5]] {
; CHECK-NEXT:    [[Q1:%.*]] = tail call i64 @llvm.riscv.query.lambda.i64()
; CHECK-NEXT:    [[W:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 3)
; CHECK-NEXT:    [[Q3:%.*]] = tail call i64 @llvm.riscv.query.lambda.i64()
; CHECK-NEXT:    [[S1:%.*]] = shl i64 [[Q1]], 1
; CHECK-NEXT:    [[S2:%.*]] = add i64 [[Q3]], [[S1]]
; CHECK-NEXT:    ret i64 [[S2]]
;
  %q1 = call i64 @llvm.riscv.query.lambda.i64()
  %q2 = call i64 @llvm.riscv.query.lambda.i64()
  %w = call i64 @llvm.riscv.vsetlambda.i64(i64 3)
  %q3 = call i64 @llvm.riscv.query.lambda.i64()
  %s1 = add i64 %q1, %q2
  %s2 = add i64 %s1, %q3
  ret i64 %s2
}

; Identical MACs are CSE'd across an ordinary store, but not across a lambda
; write. (They are also not CSE'd across a tile-store call: its effects,
; argmem: write + inaccessiblemem: read, do not conflict with the MAC's, but
; call-vs-call alias analysis does not prove that.) The ordinary RVV vadd is
; CSE'd across the lambda write.
define void @mac_cse(<vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
