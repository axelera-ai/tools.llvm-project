; CHECK-NEXT:    [[C1:%.*]] = tail call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32.i64(<vscale x 2 x i32> [[C]], <vscale x 2 x i32> [[A]], <vscale x 2 x i32> [[B]], i64 [[VL]])
; CHECK-NEXT:    store <vscale x 2 x i32> [[C1]], ptr [[Q]], align 8
; CHECK-NEXT:    tail call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> [[C1]], ptr [[P]], i64 [[LD]], i64 [[VL]])
; CHECK-NEXT:    [[V1:%.*]] = tail call <vscale x 2 x i32> @llvm.riscv.vadd.nxv2i32.nxv2i32.i64(<vscale x 2 x i32> poison, <vscale x 2 x i32> [[A]], <vscale x 2 x i32> [[B]], i64 [[VL]])
; CHECK-NEXT:    [[W:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 2)
; CHECK-NEXT:    [[C3:%.*]] = tail call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32.i64(<vscale x 2 x i32> [[C]], <vscale x 2 x i32> [[A]], <vscale x 2 x i32> [[B]], i64 [[VL]])
; CHECK-NEXT:    tail call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> [[C3]], ptr [[P]], i64 [[LD]], i64 [[VL]])
; CHECK-NEXT:    tail call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> [[V1]], ptr [[P]], i64 [[LD]], i64 [[VL]])
; CHECK-NEXT:    ret void
;
  <vscale x 2 x i32> %b, i64 %vl, ptr %p, ptr %q,
  i64 %ld) {
  %c1 = call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
  <vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
