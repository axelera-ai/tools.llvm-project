; A tile load is not hoisted out of a loop that writes lambda, even though
; its operands are loop-invariant and nothing in the loop stores to %src.
define void @tile_load_no_licm(ptr noalias %src, ptr noalias %dst, i64 %ld,
; CHECK-LABEL: define void @tile_load_no_licm(
; CHECK-SAME: ptr noalias readonly captures(none) [[SRC:%.*]], ptr noalias writeonly captures(none) [[DST:%.*]], i64 [[LD:%.*]], i64 [[VL:%.*]], i64 [[N:%.*]]) local_unnamed_addr #[[ATTR7:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[W:%.*]] = tail call i64 @llvm.riscv.vsetlambda.i64(i64 3)
; CHECK-NEXT:    [[T:%.*]] = tail call <vscale x 2 x i32> @llvm.riscv.vmtl.nxv2i32.p0.i64(<vscale x 2 x i32> poison, ptr [[SRC]], i64 [[LD]], i64 [[VL]])
; CHECK-NEXT:    [[Q:%.*]] = getelementptr i32, ptr [[DST]], i64 [[I]]
; CHECK-NEXT:    tail call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> [[T]], ptr [[Q]], i64 [[LD]], i64 [[VL]])
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
  i64 %vl, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %w = call i64 @llvm.riscv.vsetlambda.i64(i64 3)
  %t = call <vscale x 2 x i32> @llvm.riscv.vmtl.nxv2i32.p0.i64(
  <vscale x 2 x i32> poison, ptr %src, i64 %ld, i64 %vl)
  %q = getelementptr i32, ptr %dst, i64 %i
  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %t, ptr %q,
  i64 %ld, i64 %vl)
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
