}

; FP16 -> BF16 -> FP16 accumulation under one vsetvl_matrix(e16): no vsetvli
; before the first MAC, e16alt before the BF16 one, e16 again before the last.
define <vscale x 4 x half> @matrix_fp16_bf16_fp16(<vscale x 4 x half> %c, <vscale x 4 x half> %a, <vscale x 4 x half> %b, <vscale x 4 x bfloat> %cb, <vscale x 4 x bfloat> %ab, <vscale x 4 x bfloat> %bb, ptr %p, i64 %avl) {
; CHECK-LABEL: matrix_fp16_bf16_fp16:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 200
; CHECK-NEXT:    vsetvl a2, a1, a2
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfmmacc.vv v11, v12, v13
; CHECK-NEXT:    vs1r.v v11, (a0)
; CHECK-NEXT:    vsetvli zero, zero, e16, m1, ta, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 0, i64 0, i64 0, i64 0)
  %c1 = call <vscale x 4 x half> @llvm.riscv.vfmmacc.nxv4f16.nxv4f16.i64(<vscale x 4 x half> %c, <vscale x 4 x half> %a, <vscale x 4 x half> %b, i64 %vl)
  %r = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %cb, <vscale x 4 x bfloat> %ab, <vscale x 4 x bfloat> %bb, i64 %vl)
  store <vscale x 4 x bfloat> %r, ptr %p
  %c2 = call <vscale x 4 x half> @llvm.riscv.vfmmacc.nxv4f16.nxv4f16.i64(<vscale x 4 x half> %c1, <vscale x 4 x half> %a, <vscale x 4 x half> %b, i64 %vl)
  ret <vscale x 4 x half> %c2
}

; FP16 accumulator (OFP8 inputs) right after a BF16 one (OFP8 inputs) and
; the MXINT8 pair: each FP16 MAC must clear altfmt again.
define <vscale x 4 x half> @matrix_bf16_then_fp16_ofp8(<vscale x 4 x bfloat> %cb, <vscale x 4 x half> %ch, <vscale x 8 x i8> %a, <vscale x 8 x i8> %b, <vscale x 4 x i16> %scale, ptr %p, i64 %avl) {
; CHECK-LABEL: matrix_bf16_then_fp16_ofp8:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vsetivli zero, 1, e8, m1, ta, ma
; CHECK-NEXT:    vmv1r.v v0, v12
; CHECK-NEXT:    li a2, 200
; CHECK-NEXT:    vsetvl a2, a1, a2
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfwmmacc.vv v8, v10, v11
; CHECK-NEXT:    vs1r.v v8, (a0)
; CHECK-NEXT:    vsetvli zero, zero, e16, m1, ta, ma
; CHECK-NEXT:    vfwmmacc.vv v9, v10, v11
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfwimmacc.vv v8, v10, v11, v0.scale
; CHECK-NEXT:    vs1r.v v8, (a0)
; CHECK-NEXT:    vsetvli zero, zero, e16, m1, ta, ma
; CHECK-NEXT:    vfwimmacc.vv v9, v10, v11, v0.scale
; CHECK-NEXT:    vmv1r.v v8, v9
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 0, i64 0, i64 0, i64 0)
  %r0 = call <vscale x 4 x bfloat> @llvm.riscv.vfwmmacc.nxv4bf16.nxv8i8.i64(<vscale x 4 x bfloat> %cb, <vscale x 8 x i8> %a, <vscale x 8 x i8> %b, i64 %vl)
  store <vscale x 4 x bfloat> %r0, ptr %p
  %h0 = call <vscale x 4 x half> @llvm.riscv.vfwmmacc.nxv4f16.nxv8i8.i64(<vscale x 4 x half> %ch, <vscale x 8 x i8> %a, <vscale x 8 x i8> %b, i64 %vl)
  %r1 = call <vscale x 4 x bfloat> @llvm.riscv.vfwimmacc.nxv4bf16.nxv8i8.i64(<vscale x 4 x bfloat> %r0, <vscale x 8 x i8> %a, <vscale x 8 x i8> %b, <vscale x 4 x i16> %scale, i64 0, i64 %vl)
