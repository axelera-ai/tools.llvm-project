  %h1 = call <vscale x 4 x half> @llvm.riscv.vfwimmacc.nxv4f16.nxv8i8.i64(<vscale x 4 x half> %h0, <vscale x 8 x i8> %a, <vscale x 8 x i8> %b, <vscale x 4 x i16> %scale, i64 0, i64 %vl)
  ret <vscale x 4 x half> %h1
}

