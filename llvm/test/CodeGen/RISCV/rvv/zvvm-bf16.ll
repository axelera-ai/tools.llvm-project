; CHECK-NEXT:    slli a2, a2, 57
; CHECK-NEXT:    addi a2, a2, 200
; CHECK-NEXT:    vsetvl a2, a1, a2
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    vsetvli zero, zero, e16, m1, ta, ma
; CHECK-NEXT:    vfadd.vv v9, v11, v12
; CHECK-NEXT:    vs1r.v v8, (a0)
; CHECK-NEXT:    vmv.v.v v8, v9
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 0, i64 0, i64 1, i64 1)
  %r = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %cb, <vscale x 4 x bfloat> %ab, <vscale x 4 x bfloat> %bb, i64 %vl)
  store <vscale x 4 x bfloat> %r, ptr %p
  %s = call <vscale x 4 x half> @llvm.riscv.vfadd.nxv4f16.nxv4f16.i64(<vscale x 4 x half> poison, <vscale x 4 x half> %x, <vscale x 4 x half> %y, i64 7, i64 %vl)
  ret <vscale x 4 x half> %s
}

; BF16 GEMM-style loop: vsetvl_matrix in the preheader, BF16 MAC in the loop.
; The preheader's vsetvl_matrix leaves altfmt = 0 (it has no altfmt operand)
; and PRE only hoists out of unknown-state predecessors, so the VL-preserving
; e16alt transition currently stays in the loop body — correct, but a
; vsetvl_matrix that can program altfmt would remove it.
define <vscale x 4 x bfloat> @matrix_bf16_loop(<vscale x 4 x bfloat> %c0, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %avl, i64 %n) {
; CHECK-LABEL: matrix_bf16_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 3
; CHECK-NEXT:    slli a2, a2, 57
; CHECK-NEXT:    addi a2, a2, 200
; CHECK-NEXT:    vsetvl a2, a0, a2
; CHECK-NEXT:  .LBB16_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, tu, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    bnez a1, .LBB16_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 0, i64 0, i64 1, i64 1)
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %c = phi <vscale x 4 x bfloat> [ %c0, %entry ], [ %c.next, %loop ]
  %c.next = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %vl)
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret <vscale x 4 x bfloat> %c.next
}
