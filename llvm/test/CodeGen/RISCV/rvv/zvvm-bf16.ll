; BFloat16 accumulators and inputs on the Zvvm FP MACs.
;
; Per the IME spec the FP accumulator format is selected by vtype.altfmt (the
; Zvfbfa bit) together with SEW: SEW=16 with altfmt=0 is IEEE binary16, with
; altfmt=1 BFloat16 (and altfmt=1 is reserved at SEW=32/64). vsetvl_matrix
; cannot write altfmt, so RISCVInsertVSETVLI establishes it from the IR
; accumulator type: e16alt before a BF16-accumulator MAC, altfmt cleared
; before an FP16 / FP32 / FP64 one. Since altfmt's meaning depends on SEW, an
; FP MAC also demands its accumulator SEW, its A/B LMUL and its VL; a
; correctly-programmed vsetvl_matrix already supplies those, leaving altfmt as
; the only field the pass has to change. The input formats (altfmt_A /
; altfmt_B = 1 for BF16 inputs) remain caller state, like integer signedness.
;
; Only the Zvfbfmin type support (not Zvfbfa) is enabled here: e16alt must
; still print symbolically because the Zvvm BF16 extensions define altfmt.

target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"

;===------------------------------------------------------------------------===;
; One cell per new spec row (entry state unknown: the MAC establishes its full
; vtype, tail-undisturbed).
;===------------------------------------------------------------------------===;

; vfmmacc.vv BF16 <- BF16, BF16 (Zvvbf16mm). EMUL_C = 1, LMUL = 1.
define <vscale x 4 x bfloat> @vfmmacc_bf16m1(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %vl) {
; CHECK-LABEL: vfmmacc_bf16m1:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vsetvli zero, a0, e16alt, m1, tu, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    ret
entry:
  %r = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %vl)
  ret <vscale x 4 x bfloat> %r
}

