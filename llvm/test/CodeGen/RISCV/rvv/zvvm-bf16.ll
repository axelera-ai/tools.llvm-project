define <vscale x 4 x half> @matrix_bf16_then_vfadd_f16(<vscale x 4 x bfloat> %cb, <vscale x 4 x bfloat> %ab, <vscale x 4 x bfloat> %bb, <vscale x 4 x half> %x, <vscale x 4 x half> %y, ptr %p, i64 %avl) {
