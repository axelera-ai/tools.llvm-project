;===------------------------------------------------------------------------===;
; altfmt transitions after a caller-issued vsetvl_matrix.
;===------------------------------------------------------------------------===;

; vsetvl_matrix(e16, m1, ta, ma, lambda=0, altfmt_A=B=1) programs everything
; but altfmt (0). The BF16-accumulator MAC needs e16alt; SEW / LMUL / VL /
; matrix fields already match, so a VL-preserving vsetvli that flips only
; altfmt is emitted after the register-form vsetvl.
define <vscale x 4 x bfloat> @matrix_bf16_after_vsetvl_matrix(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %avl) {
; CHECK-LABEL: matrix_bf16_after_vsetvl_matrix:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a1, 3
; CHECK-NEXT:    slli a1, a1, 57
; CHECK-NEXT:    addi a1, a1, 200
; CHECK-NEXT:    vsetvl a1, a0, a1
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 0, i64 0, i64 1, i64 1)
  %r = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %vl)
  ret <vscale x 4 x bfloat> %r
}

; Same with a selected lambda (L4): the tracked matrix state is preserved, and
; the altfmt-only transition is still a plain `vsetvli zero, zero` (same SEW,
; so hardware keeps lambda; bs / altfmt_A / altfmt_B are retained verbatim),
; not a second register-form vsetvl.
define <vscale x 4 x bfloat> @matrix_bf16_lambda_after_vsetvl_matrix(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %avl) {
; CHECK-LABEL: matrix_bf16_lambda_after_vsetvl_matrix:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a1, 27
; CHECK-NEXT:    slli a1, a1, 57
; CHECK-NEXT:    addi a1, a1, 200
; CHECK-NEXT:    vsetvl a1, a0, a1
; CHECK-NEXT:    vsetvli zero, zero, e16alt, m1, ta, ma
; CHECK-NEXT:    vfmmacc.vv v8, v9, v10
; CHECK-NEXT:    ret
entry:
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 0, i64 1, i64 1, i64 3, i64 0, i64 1, i64 1)
  %r = call <vscale x 4 x bfloat> @llvm.riscv.vfmmacc.nxv4bf16.nxv4bf16.i64(<vscale x 4 x bfloat> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %vl)
  ret <vscale x 4 x bfloat> %r
}

; FP32 <- BF16 after vsetvl_matrix(e32, altfmt_A=B=1): altfmt is already 0,
; nothing is inserted.
define <vscale x 2 x float> @matrix_f32_bf16_after_vsetvl_matrix(<vscale x 2 x float> %c, <vscale x 4 x bfloat> %a, <vscale x 4 x bfloat> %b, i64 %avl) {
