; Pair two m8 halves into an m16 accumulator (tuple inserts), run the MAC,
; and extract both halves — the pair/unpair pseudo-intrinsic lowering shape.
; With clean allocation this coalesces to zero whole-register moves around
; the MAC.
define <vscale x 16 x i32> @pair_mac_unpair(<vscale x 16 x i32> %lo, <vscale x 16 x i32> %hi, <vscale x 2 x i32> %vs1, <vscale x 2 x i32> %vs2, i64 %vl) {
; CHECK-LABEL: pair_mac_unpair:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vl1re32.v v7, (a1)
; CHECK-NEXT:    vl1re32.v v6, (a0)
; CHECK-NEXT:    vsetivli zero, 1, e8, m1, ta, ma
; CHECK-NEXT:    vmv8r.v v24, v16
; CHECK-NEXT:    vmv8r.v v16, v8
; CHECK-NEXT:    vmmacc.vv v16, v6, v7
; CHECK-NEXT:    vsetvli a0, zero, e32, m8, ta, ma
; CHECK-NEXT:    vadd.vv v8, v16, v24
; CHECK-NEXT:    ret
entry:
  %p0 = call target("riscv.vector.tuple", <vscale x 64 x i8>, 2) @llvm.riscv.tuple.insert.triscv.vector.tuple_nxv64i8_2t.nxv16i32(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) poison, <vscale x 16 x i32> %lo, i32 0)
  %p1 = call target("riscv.vector.tuple", <vscale x 64 x i8>, 2) @llvm.riscv.tuple.insert.triscv.vector.tuple_nxv64i8_2t.nxv16i32(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %p0, <vscale x 16 x i32> %hi, i32 1)
  %acc = call target("riscv.vector.tuple", <vscale x 64 x i8>, 2) @llvm.riscv.vmmacc.m16.triscv.vector.tuple_nxv64i8_2t.nxv2i32.i64(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %p1, <vscale x 2 x i32> %vs1, <vscale x 2 x i32> %vs2, i64 %vl)
  %outlo = call <vscale x 16 x i32> @llvm.riscv.tuple.extract.nxv16i32.triscv.vector.tuple_nxv64i8_2t(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %acc, i32 0)
  %outhi = call <vscale x 16 x i32> @llvm.riscv.tuple.extract.nxv16i32.triscv.vector.tuple_nxv64i8_2t(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %acc, i32 1)
  %sum = add <vscale x 16 x i32> %outlo, %outhi
  ret <vscale x 16 x i32> %sum
}
