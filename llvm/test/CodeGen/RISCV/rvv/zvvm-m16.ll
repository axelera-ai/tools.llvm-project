define target("riscv.vector.tuple", <vscale x 64 x i8>, 2) @vfmmacc_m16_f32_lm1(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %vd, <vscale x 2 x float> %vs1, <vscale x 2 x float> %vs2, i64 %vl) {
