entry:
  %0 = call target("riscv.vector.tuple", <vscale x 64 x i8>, 2) @llvm.riscv.vqmmacc.m16.triscv.vector.tuple_nxv64i8_2t.nxv16i8.i64(target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %vd, <vscale x 16 x i8> %vs1, <vscale x 16 x i8> %vs2, i64 %vl)
  ret target("riscv.vector.tuple", <vscale x 64 x i8>, 2) %0
}

