; The Zvvm matrix vtype-state writers (llvm.riscv.vsetlambda,
; llvm.riscv.vsetvl.matrix) read and write inaccessible memory, and the
; readers (query_lambda, MACs, tile loads/stores) read it. Check that the
; writes survive with their result unused, that identical writes and
; identical reads separated by a write are not CSE'd (SelectionDAG CSE would
; merge chain-less nodes), and that readers stay on the correct side of the
; writes.

declare i64 @llvm.riscv.vsetlambda.i64(i64)
declare i64 @llvm.riscv.query.lambda.i64()
declare i64 @llvm.riscv.vsetvl.matrix.i64(i64, i64 immarg, i64 immarg,
  i64 immarg, i64 immarg, i64 immarg, i64 immarg, i64 immarg, i64 immarg)
declare <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
  <vscale x 2 x i32>, <vscale x 2 x i32>, <vscale x 2 x i32>, i64)
declare <vscale x 2 x i32> @llvm.riscv.vmtl.nxv2i32.p0.i64(
  <vscale x 2 x i32>, ptr, i64, i64)
declare void @llvm.riscv.vmts.nxv2i32.p0.i64(
  <vscale x 2 x i32>, ptr, i64, i64)

; A lambda write whose result is unused must still be emitted.
define void @vsetlambda_unused() nounwind {
; CHECK-LABEL: vsetlambda_unused:
; CHECK:       # %bb.0:
; CHECK-NEXT:    csrr a0, vtype
; CHECK-NEXT:    li a1, 7
; CHECK-NEXT:    slli a1, a1, 60
; CHECK-NEXT:    not a1, a1
; CHECK-NEXT:    and a0, a0, a1
; CHECK-NEXT:    li a1, 5
; CHECK-NEXT:    slli a1, a1, 60
; CHECK-NEXT:    or a0, a0, a1
; CHECK-NEXT:    csrr a1, vl
; CHECK-NEXT:    vsetvl a1, a1, a0
; CHECK-NEXT:    csrr a0, vtype
; CHECK-NEXT:    srli a0, a0, 60
; CHECK-NEXT:    andi a0, a0, 7
; CHECK-NEXT:    ret
  %r = call i64 @llvm.riscv.vsetlambda.i64(i64 5)
  ret void
}

; Same for a full matrix vtype write (SEW=16, LMUL=4, lambda=L16).
define void @vsetvl_matrix_unused(i64 %avl) nounwind {
; CHECK-LABEL: vsetvl_matrix_unused:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, 5
; CHECK-NEXT:    slli a1, a1, 60
; CHECK-NEXT:    addi a1, a1, 202
; CHECK-NEXT:    vsetvl a1, a0, a1
; CHECK-NEXT:    ret
  %vl = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %avl, i64 1, i64 2,
          i64 1, i64 1, i64 5, i64 0, i64 0, i64 0)
  ret void
}

; Two identical lambda writes are both emitted.
define i64 @vsetlambda_twice() nounwind {
; CHECK-LABEL: vsetlambda_twice:
; CHECK:       # %bb.0:
; CHECK-NEXT:    csrr a0, vtype
; CHECK-NEXT:    li a1, 7
; CHECK-NEXT:    slli a1, a1, 60
; CHECK-NEXT:    not a1, a1
; CHECK-NEXT:    and a0, a0, a1
; CHECK-NEXT:    li a1, 5
; CHECK-NEXT:    slli a1, a1, 60
; CHECK-NEXT:    or a0, a0, a1
; CHECK-NEXT:    csrr a1, vl
; CHECK-NEXT:    vsetvl a1, a1, a0
; CHECK-NEXT:    csrr a0, vtype
; CHECK-NEXT:    srli a0, a0, 60
; CHECK-NEXT:    andi a0, a0, 7
; CHECK-NEXT:    csrr a1, vtype
; CHECK-NEXT:    li a2, 7
; CHECK-NEXT:    slli a2, a2, 60
; CHECK-NEXT:    not a2, a2
; CHECK-NEXT:    and a1, a1, a2
; CHECK-NEXT:    li a2, 5
; CHECK-NEXT:    slli a2, a2, 60
