; Two lambda queries separated by a write read vtype twice, on either side
; of the write.
define i64 @query_around_write() nounwind {
; CHECK-LABEL: query_around_write:
; CHECK:       # %bb.0:
; CHECK-NEXT:    csrr a0, vtype
; CHECK-NEXT:    srli a0, a0, 60
; CHECK-NEXT:    andi a0, a0, 7
; CHECK-NEXT:    csrr a1, vtype
; CHECK-NEXT:    li a2, 7
; CHECK-NEXT:    slli a2, a2, 60
; CHECK-NEXT:    not a2, a2
; CHECK-NEXT:    and a1, a1, a2
; CHECK-NEXT:    li a2, 3
; CHECK-NEXT:    slli a2, a2, 60
; CHECK-NEXT:    or a1, a1, a2
; CHECK-NEXT:    csrr a2, vl
; CHECK-NEXT:    vsetvl a2, a2, a1
; CHECK-NEXT:    csrr a1, vtype
; CHECK-NEXT:    srli a1, a1, 60
; CHECK-NEXT:    andi a1, a1, 7
; CHECK-NEXT:    csrr a1, vtype
; CHECK-NEXT:    srli a1, a1, 60
; CHECK-NEXT:    andi a1, a1, 7
; CHECK-NEXT:    add a0, a0, a1
; CHECK-NEXT:    ret
  %q1 = call i64 @llvm.riscv.query.lambda.i64()
  %w = call i64 @llvm.riscv.vsetlambda.i64(i64 3)
  %q2 = call i64 @llvm.riscv.query.lambda.i64()
  %s = add i64 %q1, %q2
  ret i64 %s
}

; Two identical MACs separated by a lambda write are distinct operations
; (they run under different lambda values) and are emitted on either side of
; the write.
define void @mac_around_write(<vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
; CHECK-LABEL: mac_around_write:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a4, 3
; CHECK-NEXT:    slli a4, a4, 60
; CHECK-NEXT:    addi a4, a4, 208
; CHECK-NEXT:    vsetvl a4, a0, a4
; CHECK-NEXT:    vmv1r.v v11, v8
; CHECK-NEXT:    vmmacc.vv v11, v9, v10
; CHECK-NEXT:    csrr a4, vtype
; CHECK-NEXT:    li a5, 7
; CHECK-NEXT:    slli a5, a5, 60
; CHECK-NEXT:    not a5, a5
; CHECK-NEXT:    and a4, a4, a5
; CHECK-NEXT:    li a5, 2
; CHECK-NEXT:    slli a5, a5, 60
; CHECK-NEXT:    or a4, a4, a5
; CHECK-NEXT:    csrr a5, vl
; CHECK-NEXT:    vsetvl a5, a5, a4
; CHECK-NEXT:    csrr a4, vtype
; CHECK-NEXT:    srli a4, a4, 60
; CHECK-NEXT:    andi a4, a4, 7
; CHECK-NEXT:    vmmacc.vv v8, v9, v10
; CHECK-NEXT:    vmts.v v11, (a1), a3
; CHECK-NEXT:    vmts.v v8, (a2), a3
; CHECK-NEXT:    ret
                              <vscale x 2 x i32> %b, i64 %vl, ptr %p0,
                              ptr %p1, i64 %ld) nounwind {
  %vt = call i64 @llvm.riscv.vsetvl.matrix.i64(i64 %vl, i64 2, i64 0,
          i64 1, i64 1, i64 3, i64 0, i64 0, i64 0)
  %c1 = call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
          <vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
          <vscale x 2 x i32> %b, i64 %vl)
  %w = call i64 @llvm.riscv.vsetlambda.i64(i64 2)
  %c2 = call <vscale x 2 x i32> @llvm.riscv.vmmacc.nxv2i32.nxv2i32(
          <vscale x 2 x i32> %c, <vscale x 2 x i32> %a,
          <vscale x 2 x i32> %b, i64 %vl)
  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %c1, ptr %p0,
                                            i64 %ld, i64 %vl)
  call void @llvm.riscv.vmts.nxv2i32.p0.i64(<vscale x 2 x i32> %c2, ptr %p1,
                                            i64 %ld, i64 %vl)
  ret void
}

